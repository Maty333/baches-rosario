# Puerto del API (debe coincidir con VITE_API_URL en el frontend si no usás proxy)
PORT=3001
# URL pública del backend (links en emails de verificación; por defecto usa localhost:PORT)
# BACKEND_URL=http://localhost:3001
MONGODB_URI=mongodb://localhost:27017/baches-rosario
JWT_SECRET=tu_clave_secreta
NODE_ENV=development
# Debe coincidir con el origen del front (puerto de Vite: por defecto 5173)
FRONTEND_URL=http://localhost:5173
# Orígenes CORS en producción (coma-separados). En dev ya incluye 5173 y 5174.
# ALLOWED_ORIGINS=https://tu-dominio.com

# Email (opcional en dev: sin esto el link se muestra en consola)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=noreply@tudominio.com

# Google OAuth (opcional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
